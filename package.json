{
  "name": "pintar",
  "version": "1.3.0",
  "description": "Pintar – średniowieczne miasto z klocków (voxel city builder)",
  "author": "navro.",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "prepare-game": "node scripts/prepare.js",
    "postinstall": "node scripts/prepare.js",
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "three": "0.128.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "pl.navro.pintar",
    "productName": "Pintar",
    "files": [
      "index.html",
      "three.min.js",
      "manifest.webmanifest",
      "electron/**",
      "icons/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icons/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Pintar",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Pintar-Setup-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "pionawroarch",
      "repo": "pintar",
      "releaseType": "release"
    },
    "portable": {
      "artifactName": "Pintar-Portable-${version}.exe"
    }
  }
}