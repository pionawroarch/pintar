{
  "name": "pintar",
  "version": "1.2.0",
  "description": "Pintar – średniowieczne miasto z klocków (voxel city builder)",
  "author": "navro.",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "prepare-game": "node scripts/prepare.js",
    "postinstall": "node scripts/prepare.js",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "three": "0.128.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "pl.navro.pintar",
    "productName": "Pintar",
    "files": [
      "index.html",
      "three.min.js",
      "manifest.webmanifest",
      "electron/**",
      "icons/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icons/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "icon": "icons/icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "icons/icon-512.png"
    }
  }
}